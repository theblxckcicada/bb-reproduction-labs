# ---------------------------------------------------------------------------
# Ovawatch Labs platform configuration
# Copy this file to `.env` and adjust as needed. All values have safe defaults,
# so the platform runs without a .env file at all.
# ---------------------------------------------------------------------------

# Display name shown in the UI header.
BRAND_NAME=Ovawatch Labs

# Interface the platform binds to. Keep 127.0.0.1 — the labs are deliberately
# vulnerable and must NOT be exposed on a routable interface.
BIND_HOST=127.0.0.1

# Port the platform control plane listens on.
PORT=8080

# Absolute path to the labs directory. Defaults to ../Labs relative to platform/.
# LABS_DIR=E:\Ova-Watch\Personal Projects\Development\bb-reproduction-labs\Labs

# Inclusive port range assigned to launched labs (one port per running lab).
LAB_PORT_RANGE=4100-4199

# Maximum number of labs allowed to run at the same time.
MAX_CONCURRENT=5

# Auto-stop a running lab after this many minutes with no activity.
# The UI sends a heartbeat while a lab page is open, which resets the timer.
IDLE_TTL_MIN=20

# Readiness timeout (ms) when starting a lab before it is considered failed.
START_TIMEOUT_MS=60000

# Timeout (ms) for the one-time `npm install` step on first launch of a lab.
INSTALL_TIMEOUT_MS=180000

# Number of recent log lines retained per lab instance (ring buffer).
LOG_BUFFER_LINES=500

# Logger verbosity: error | warn | info | debug
LOG_LEVEL=info
